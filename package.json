{
  "name": "pick-xi",
  "version": "1.0.0",
  "description": "Pick XI & Simulate — MEAN Stack Football Match Simulator",
  "scripts": {
    "build": "cd client && npm install && npm run build",
    "server": "cd server && node server.js",
    "client": "cd client && npx ng serve --proxy-config proxy.conf.json",
    "seed": "cd server && node seeds/seed.js",
    "seed:matches": "cd server && node seeds/seedMatches.js",
    "seed:all": "cd server && npm run seed:all",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "keywords": [
    "football",
    "simulator",
    "mean-stack"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1"
  }
}
